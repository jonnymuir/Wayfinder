{
  "name": "@wayfinder/reference-app-tests",
  "version": "0.1.0",
  "private": true,
  "description": "End-to-end Playwright suite against the transient Wayfinder.ReferenceApp — doubles as narrated documentation of the citizen/caseworker journeys and the authoring surface.",
  "scripts": {
    "test:playwright": "playwright test",
    "test:playwright:ui": "playwright test --ui",
    "test:playwright:live": "playwright test -c playwright.live.config.ts --reporter=line",
    "demo:record:overview": "playwright test -c playwright.demo.config.ts tests/demo/wayfinder-overview-demo.spec.ts --reporter=line",
    "demo:record:bulk-data-review": "playwright test -c playwright.demo.config.ts tests/demo/bulk-data-review-demo.spec.ts --reporter=line",
    "docs:screenshots": "CAPTURE_DOC_SCREENSHOTS=1 playwright test calculations-editor.spec.ts --workers=1",
    "docs:screenshots:bulk-data-review": "CAPTURE_DOC_SCREENSHOTS=1 playwright test -c playwright.live.config.ts bulk-data-review-screenshots-live.spec.ts --reporter=line"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.46.1",
    "@types/qrcode-generator": "^0.0.16",
    "axe-core": "^4.13.0",
    "qrcode-generator": "^2.0.4"
  }
}
