root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{csproj,props,targets,slnx,json,yml,yaml,ts,js,mjs,css,html,cshtml}]
indent_size = 2

[*.cshtml]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.cs]
csharp_style_namespace_declarations = file_scoped:suggestion
dotnet_sort_system_directives_first = true
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion

# Tests name behaviours with underscores (Behaviour_Under_Condition_Outcome).
[Wayfinder.Tests/**.cs]
dotnet_diagnostic.CA1707.severity = none

# Removed when the engine is split into focused collaborators, each of which gets source-generated logging.
[Wayfinder.Engine/Services/ProcessManagerEngine.cs]
dotnet_diagnostic.CA1848.severity = suggestion
dotnet_diagnostic.CA1873.severity = suggestion
