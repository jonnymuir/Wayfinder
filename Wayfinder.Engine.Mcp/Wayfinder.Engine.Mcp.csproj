<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Wayfinder.Engine.Mcp</RootNamespace>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageId>Wayfinder.Engine.Mcp</PackageId>
    <Title>Wayfinder Blueprint Authoring MCP</Title>
    <Version>0.9.2</Version>
    <Authors>Jonny Muir</Authors>
    <Company>Wayfinder</Company>
    <Description>ASP.NET Core MCP-over-HTTP endpoint mapping that exposes Wayfinder service blueprint authoring (list/read/validate/save/simulate) as MCP tools — a single MapServiceBlueprintAuthoringMcp() call any host adds to its own pipeline, alongside MapServiceBlueprintAuthoringApi(), inheriting its own auth.</Description>
    <PackageTags>Blueprint;MCP;Model-Context-Protocol;GDS;Wayfinder</PackageTags>
    <PackageProjectUrl>https://github.com/jonnymuir/Wayfinder</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jonnymuir/Wayfinder</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageIcon>assets/icon-wayfinder-engine-mcp.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Wayfinder.Engine/Wayfinder.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="../docs/guides/calculation-language.md" LogicalName="Wayfinder.Engine.Mcp.docs.calculation-language.md" />
    <EmbeddedResource Include="../docs/guides/reference-service-blueprint-contract.md" LogicalName="Wayfinder.Engine.Mcp.docs.reference-service-blueprint-contract.md" />
    <EmbeddedResource Include="../docs/guides/service-design-principles.md" LogicalName="Wayfinder.Engine.Mcp.docs.service-design-principles.md" />
    <EmbeddedResource Include="../docs/guides/ai-service-blueprint-authoring.md" LogicalName="Wayfinder.Engine.Mcp.docs.ai-service-blueprint-authoring.md" />
    <EmbeddedResource Include="../docs/guides/extending-the-component-catalog.md" LogicalName="Wayfinder.Engine.Mcp.docs.extending-the-component-catalog.md" />
    <EmbeddedResource Include="../docs/guides/support-systems.md" LogicalName="Wayfinder.Engine.Mcp.docs.support-systems.md" />
    <EmbeddedResource Include="../docs/guides/bulk-data-review.md" LogicalName="Wayfinder.Engine.Mcp.docs.bulk-data-review.md" />
    <EmbeddedResource Include="../docs/guides/request-concurrency.md" LogicalName="Wayfinder.Engine.Mcp.docs.request-concurrency.md" />
    <EmbeddedResource Include="../docs/guides/queue-worklist-filtering.md" LogicalName="Wayfinder.Engine.Mcp.docs.queue-worklist-filtering.md" />
    <EmbeddedResource Include="../docs/guides/work-allocation.md" LogicalName="Wayfinder.Engine.Mcp.docs.work-allocation.md" />
    <EmbeddedResource Include="../docs/guides/team-assignment.md" LogicalName="Wayfinder.Engine.Mcp.docs.team-assignment.md" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../assets/icon-wayfinder-engine-mcp.png" Pack="true" PackagePath="assets/" />
    <None Include="../LICENSE" Pack="true" PackagePath="/" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
