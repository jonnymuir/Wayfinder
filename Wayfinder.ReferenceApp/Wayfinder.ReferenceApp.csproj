<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>aspire-Wayfinder.ReferenceApp</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Wayfinder/Wayfinder.csproj" />
    <ProjectReference Include="../Wayfinder.Engine/Wayfinder.Engine.csproj" />
    <ProjectReference Include="../Wayfinder.Engine.Api/Wayfinder.Engine.Api.csproj" />
    <ProjectReference Include="../Wayfinder.Engine.Mcp/Wayfinder.Engine.Mcp.csproj" />
    <ProjectReference Include="../Wayfinder.Editor/Wayfinder.Editor.csproj" />
    <ProjectReference Include="../Wayfinder.Rendering.GovUk/Wayfinder.Rendering.GovUk.csproj" />
    <ProjectReference Include="../Wayfinder.ServiceDefaults/Wayfinder.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="service-blueprints\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
