{
  "definitionKey": "juggling-licence",
  "displayName": "Apply for a licence to hold a juggling event",
  "version": 1,
  "description": "GOV.UK Service Manual's own teaching exemplar, used here to demonstrate a two-actor service blueprint: an applicant's frontstage journey and a caseworker's backstage review queue.",
  "initialStage": "your-details",
  "requestPolicy": "single",
  "calculations": {
    "fields": {
      "mitigationHasEvidence": {
        "expr": "matches(riskMitigationNotes, '\\b\\d+\\s?(m|metres|meters)\\b') or matches(riskMitigationNotes, '\\b(HSE|IOSH|NOABA)\\b')"
      }
    }
  },
