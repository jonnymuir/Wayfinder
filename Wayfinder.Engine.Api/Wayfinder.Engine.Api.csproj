<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageId>Wayfinder.Engine.Api</PackageId>
    <Title>Wayfinder Blueprint Authoring API</Title>
    <Version>0.9.2</Version>
    <Authors>Jonny Muir</Authors>
    <Company>Wayfinder</Company>
    <Description>ASP.NET Core minimal-API endpoint mapping that exposes Wayfinder service blueprint authoring (list/read/validate/save/simulate) as HTTP endpoints — a single MapServiceBlueprintAuthoringApi() call any host adds to its own pipeline, inheriting its own auth.</Description>
    <PackageTags>Blueprint;WebApi;GDS;Wayfinder</PackageTags>
    <PackageProjectUrl>https://github.com/jonnymuir/Wayfinder</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jonnymuir/Wayfinder</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageIcon>assets/icon-wayfinder-engine-api.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Wayfinder.Engine/Wayfinder.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../assets/icon-wayfinder-engine-api.png" Pack="true" PackagePath="assets/" />
    <None Include="../LICENSE" Pack="true" PackagePath="/" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
