<Project>
  <!-- Ship the existing /// XML doc comments to consumers of every published package. Stage 1:
       don't block the build on undocumented public members yet (CS1591). -->
  <PropertyGroup Condition="'$(IsPackable)' == 'true'">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
</Project>
