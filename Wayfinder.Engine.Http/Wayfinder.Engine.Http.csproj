<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageId>Wayfinder.Engine.Http</PackageId>
    <Title>Wayfinder Engine HTTP Request Glue</Title>
    <Version>0.2.2</Version>
    <Authors>Jonny Muir</Authors>
    <Company>Wayfinder</Company>
    <Description>The engine's own HTTP-request-processing glue a host otherwise hand-copies per route — currently just file-upload handling (validating a posted file against a field's own declared MaxSizeBytes/AcceptedFileTypes, saving it via IServiceRequestFileStorage, and writing the resulting reference into fieldValues). Plain functions, no routing of its own — a host calls these from inside its own minimal-API handlers, the same way Wayfinder.Rendering.GovUk's GovUkStageJourney functions are called.</Description>
    <PackageTags>Blueprint;Wayfinder</PackageTags>
    <PackageProjectUrl>https://github.com/jonnymuir/Wayfinder</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jonnymuir/Wayfinder</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageIcon>assets/icon-wayfinder-engine-http.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Wayfinder.Engine/Wayfinder.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../assets/icon-wayfinder-engine-http.png" Pack="true" PackagePath="assets/" />
    <None Include="../LICENSE" Pack="true" PackagePath="/" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
