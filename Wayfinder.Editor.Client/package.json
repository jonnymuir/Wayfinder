{
  "name": "@wayfinder/editor-client",
  "version": "0.1.0",
  "description": "Wayfinder's service blueprint visual editor as host-agnostic Lit custom elements (graph canvas, definition JSON editor, validation, simulation) with no assumptions about hosting or persistence.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonnymuir/Wayfinder.git",
    "directory": "Wayfinder.Editor.Client"
  },
  "homepage": "https://github.com/jonnymuir/Wayfinder",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "peerDependencies": {
    "lit": "^3.3.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "@xyflow/react": "^12.11.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build --config vite.service-blueprint-editor.config.ts",
    "build:lib": "tsc -p tsconfig.lib.json && vite build --config vite.lib.config.ts",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test-storybook": "test-storybook --url http://localhost:6006",
    "test-storybook:all": "test-storybook --url http://localhost:6006 --browsers chromium firefox webkit",
    "test-storybook:ci": "start-server-and-test \"storybook dev -p 6006 --ci\" http://127.0.0.1:6006 test-storybook",
    "test-storybook:ci:all": "start-server-and-test \"storybook dev -p 6006 --ci\" http://127.0.0.1:6006 \"npm run test-storybook:all\"",
    "test:playwright": "playwright test",
    "test:playwright:service-blueprint-graph-visual": "playwright test tests/service-blueprint-editor/service-blueprint-graph-visual.spec.ts --reporter=line",
    "test:playwright:ui": "playwright test --ui",
    "test:graph-layout": "node scripts/run-graph-layout-tests.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.3",
    "@codemirror/lint": "^6.9.6",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0"
  },
  "devDependencies": {
    "@xyflow/react": "^12.11.2",
    "lit": "^3.3.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "@playwright/test": "^1.46.1",
    "@storybook/addon-a11y": "^8.6.18",
    "@storybook/addon-essentials": "^8.6.18",
    "@storybook/addon-interactions": "^8.6.18",
    "@storybook/test": "^8.6.18",
    "@storybook/test-runner": "^0.21.0",
    "@storybook/testing-library": "0.2.2",
    "@storybook/web-components": "^8.6.18",
    "@storybook/web-components-vite": "^8.6.18",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "axe-playwright": "^2.1.0",
    "start-server-and-test": "^2.0.4",
    "storybook": "^8.6.18",
    "typescript": "~5.9.3",
    "vite": "^7.2.4"
  }
}
