{
  "name": "@wayfinder/editor-client",
  "private": true,
  "version": "0.1.0",
  "description": "Wayfinder's service blueprint visual editor as host-agnostic Lit custom elements (graph canvas, definition JSON editor, validation) with no assumptions about hosting or persistence. Not published to a registry — consumed by other Wayfinder projects as a pre-built ES module bundle shipped inside the Wayfinder.Editor NuGet package's static web assets, the same way any Umbraco backoffice extension bundle is loaded by URL at runtime.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build --config vite.service-blueprint-editor.config.ts && vite build --config vite.wayfinder-elements.config.ts",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test-storybook": "test-storybook --url http://localhost:6006",
    "test-storybook:all": "test-storybook --url http://localhost:6006 --browsers chromium firefox webkit",
    "test-storybook:ci": "start-server-and-test \"storybook dev -p 6006 --ci\" http://127.0.0.1:6006 test-storybook",
    "test-storybook:ci:all": "start-server-and-test \"storybook dev -p 6006 --ci\" http://127.0.0.1:6006 \"npm run test-storybook:all\"",
    "test:playwright": "playwright test",
    "test:playwright:service-blueprint-graph-visual": "playwright test tests/service-blueprint-editor/service-blueprint-graph-visual.spec.ts --reporter=line",
    "test:playwright:ui": "playwright test --ui",
    "test:graph-layout": "node scripts/run-graph-layout-tests.mjs",
    "test:component-schema": "node scripts/run-component-schema-tests.mjs",
    "test:property-references": "node scripts/run-property-references-tests.mjs",
    "test:calculation-runtime": "node scripts/run-calculation-runtime-tests.mjs",
    "test:calculation-ordering": "node scripts/run-calculation-ordering-tests.mjs",
    "test:calculation-diagnostics": "node scripts/run-calculation-diagnostics-tests.mjs",
    "test:service-blueprint-validation": "node scripts/run-service-blueprint-validation-tests.mjs",
    "test:server-diagnostic-location": "node scripts/run-server-diagnostic-location-tests.mjs",
    "test:canonical-json": "node scripts/run-canonical-json-tests.mjs",
    "docs:screenshots": "CAPTURE_DOC_SCREENSHOTS=1 playwright test service-blueprint-graph-visual.spec.ts service-blueprint-editor-gateways.spec.ts stage-action-editor.spec.ts support-system-action-editor.spec.ts service-blueprint-editor-validation.spec.ts service-blueprint-editor-definition-tab.spec.ts service-blueprint-editor-help.spec.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.3",
    "@codemirror/lint": "^6.9.6",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@xyflow/react": "^12.11.2",
    "lit": "^3.3.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.46.1",
    "@storybook/addon-a11y": "^8.6.18",
    "@storybook/addon-essentials": "^8.6.18",
    "@storybook/addon-interactions": "^8.6.18",
    "@storybook/test": "^8.6.18",
    "@storybook/test-runner": "^0.21.0",
    "@storybook/testing-library": "0.2.2",
    "@storybook/web-components": "^8.6.18",
    "@storybook/web-components-vite": "^8.6.18",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "axe-playwright": "^2.1.0",
    "bootstrap-icons": "^1.13.1",
    "start-server-and-test": "^2.0.4",
    "storybook": "^8.6.18",
    "typescript": "~5.9.3",
    "vite": "^7.2.4"
  }
}
