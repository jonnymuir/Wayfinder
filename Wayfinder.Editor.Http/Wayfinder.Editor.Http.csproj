<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageId>Wayfinder.Editor.Http</PackageId>
    <Title>Wayfinder Editor HTTP Backend</Title>
    <Version>0.6.0</Version>
    <Authors>Jonny Muir</Authors>
    <Company>Wayfinder</Company>
    <Description>The backend half of the contract Wayfinder.Editor's packaged service-blueprint-editor.html demo page expects from its bundled MockBusinessAppServiceBlueprintSource example (list/read/save a service blueprint over a small REST contract). A host that just wants the packaged editor page working out of the box calls MapMockBusinessAppServiceBlueprints() instead of hand-copying the TS example's expected routes itself.</Description>
    <PackageTags>Blueprint;Wayfinder</PackageTags>
    <PackageProjectUrl>https://github.com/jonnymuir/Wayfinder</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jonnymuir/Wayfinder</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageIcon>assets/icon-wayfinder-editor-http.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Wayfinder.Engine/Wayfinder.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../assets/icon-wayfinder-editor-http.png" Pack="true" PackagePath="assets/" />
    <None Include="../LICENSE" Pack="true" PackagePath="/" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
